# Copy to .env and fill in. Never commit .env.
#
# Google Cloud -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key.
YOUTUBE_API_KEY=

# Any OpenAI-compatible endpoint. The default endpoint uses this variable.
# Only needed when LLM cleaning is enabled (llm.enabled = true, the default).
# With llm.enabled = false or --no-llm, cleaning copies transcripts and needs no LLM key.
OPENAI_API_KEY=

# Optional environment overrides:
# OPENAI_BASE_URL=https://api.openai.com/v1
# YBOOK_LLM_MODEL=gpt-4.1-mini
# YBOOK_CHANNEL=https://www.youtube.com/@example
# YBOOK_LLM_API_KEY=used-as-a-fallback-if-OPENAI_API_KEY-is-not-set
